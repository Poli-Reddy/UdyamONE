# Local demonstration only. Copy to .env; never commit secrets.
UDYAM_ENV=development
UDYAM_DEMO=true
ALLOW_MOCK_KYC=true
ENABLE_SYNTHETIC_MODEL=true
CUSTOMER_AUTH_REQUIRED=false
ADMIN_TOKEN=
# UDYAM_DB=demo-orders.db
# UDYAM_CONSENT_LOG=demo-consent.jsonl
UDYAM_TODAY=2026-07-15
MAX_REQUEST_BYTES=41943040
OCR_CONCURRENCY=2

# Production staff identity uses OIDC bearer tokens. The role claim must contain
# one of the documented udyamone_* roles. Keep these blank for a local demo.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles
OIDC_PARTNER_CODE_CLAIM=partner_code

# Customer phone OTP. Demo mode returns a visible local test code. Production
# requires a strong pepper and an approved internal SMS/email delivery gateway.
OTP_PEPPER=
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
OTP_SESSION_HOURS=12
PARTNER_REFERRAL_SECRET=

# Cashfree Secure ID account, sandbox first.
CASHFREE_MODE=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Fictional catalogue: test payments only. Live keys are refused by code.
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta Cloud API: use the version approved for your app.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
