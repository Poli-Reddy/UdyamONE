# Copy to .env; never commit secrets. Uvicorn loads it with --env-file .env.
UDYAM_DEMO=true
ADMIN_TOKEN=
# UDYAM_DB=demo-orders.db
# UDYAM_CONSENT_LOG=demo-consent.jsonl

# Cashfree Secure ID account, sandbox first.
CASHFREE_MODE=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Fictional catalogue: test payments only. Live keys are refused by code.
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta Cloud API: use the version approved for your app.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
