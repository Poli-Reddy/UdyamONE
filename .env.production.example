# Production refuses to start unless identity settings are complete.
UDYAM_ENV=production
UDYAM_DEMO=false
ALLOW_MOCK_KYC=false
ENABLE_SYNTHETIC_MODEL=false
CUSTOMER_AUTH_REQUIRED=true
ADMIN_TOKEN=
DATABASE_URL=postgresql+psycopg://udyamone:replace-password@postgres:5432/udyamone
AUTO_CREATE_SCHEMA=false
AUTO_MIGRATE=true
POSTGRES_DB=udyamone
POSTGRES_USER=udyamone
POSTGRES_PASSWORD=replace-with-secret-manager-reference
UDYAMONE_PORT=8000
UDYAM_CONSENT_LOG=/var/lib/udyamone/consent.jsonl
MAX_REQUEST_BYTES=41943040
OCR_CONCURRENCY=2
TRUST_PROXY_HEADERS=false

OIDC_ISSUER=https://identity.example.com/realms/udyamone
OIDC_AUDIENCE=udyamone-api
OIDC_JWKS_URL=https://identity.example.com/realms/udyamone/protocol/openid-connect/certs
OIDC_ROLE_CLAIM=roles
OIDC_PARTNER_CODE_CLAIM=partner_code

OTP_PEPPER=replace-with-at-least-32-random-bytes
OTP_DELIVERY_URL=https://messaging.internal.example/v1/otp
OTP_DELIVERY_TOKEN=replace-with-secret-manager-reference
OTP_SESSION_HOURS=12
PARTNER_REFERRAL_SECRET=replace-with-at-least-32-random-bytes

CASHFREE_MODE=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
